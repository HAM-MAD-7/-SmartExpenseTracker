<style>

    .warning-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 16px;
    }

    .warning-card {
        width: 100%;
        max-width: 650px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(239,68,68,.35);
        border-radius: 28px;
        padding: 45px;
        text-align: center;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow:
            0 24px 60px rgba(0,0,0,.45),
            0 0 80px rgba(239,68,68,.18);
        position: relative;
        overflow: hidden;
        transition: .35s ease;
    }

    .warning-card::before {
        content: '';
        position: absolute;
        width: 260px;
        height: 260px;
        top: -120px;
        right: -100px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(239,68,68,.45), transparent 70%);
        filter: blur(55px);
    }

    .warning-card::after {
        content: '';
        position: absolute;
        width: 220px;
        height: 220px;
        bottom: -100px;
        left: -80px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(245,158,11,.35), transparent 70%);
        filter: blur(55px);
    }

    .warning-card:hover {
        transform: translateY(-8px);
        box-shadow:
            0 32px 75px rgba(0,0,0,.55),
            0 0 90px rgba(239,68,68,.35);
    }

    .warning-icon {
        position: relative;
        z-index: 1;
        font-size: 4rem;
        margin-bottom: 15px;
    }

    .warning-title {
        position: relative;
        z-index: 1;
        color: #F8FAFC;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .warning-text {
        position: relative;
        z-index: 1;
        color: #CBD5E1;
        font-size: 1rem;
        margin-bottom: 35px;
    }

    .warning-buttons {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .warning-btn {
        padding: 14px 26px;
        border-radius: 16px;
        text-decoration: none;
        color: white;
        font-weight: 700;
        transition: .3s;
    }

    .edit-btn {
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        box-shadow: 0 10px 30px rgba(239,68,68,.35);
    }

    .edit-btn:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 45px rgba(239,68,68,.5);
    }

    .view-btn {
        background: linear-gradient(135deg,#4f8eff,#b06cff);
        box-shadow: 0 10px 30px rgba(79,142,255,.35);
    }

    .view-btn:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 45px rgba(176,108,255,.5);
    }

    @@media (max-width:768px) {

        .warning-card {
            padding: 30px 22px;
        }

        .warning-title {
            font-size: 1.6rem;
        }

        .warning-buttons {
            flex-direction: column;
        }

        .warning-btn {
            width: 100%;
        }
    }

</style>

<div class="warning-page">

    <div class="warning-card">

        <div class="warning-icon">
            ⚠️
        </div>

        <h1 class="warning-title">
            Budget Limit Exceeded!
        </h1>

        <p class="warning-text">
            Your expense has crossed the budget limit.
            Please review your expense records.
        </p>

        <div class="warning-buttons">

            <a asp-controller="Expense"
                   asp-action="DisplayExpense"
                   class="warning-btn view-btn">
                📊 View Expenses
            </a>

        </div>

    </div>

</div>
