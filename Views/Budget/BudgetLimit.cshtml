<style>
    .warning-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 16px;
    }

    .warning-card {
        width: 100%;
        max-width: 600px;
        padding: 40px;
        text-align: center;
        border-radius: 24px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(239,68,68,.25);
        backdrop-filter: blur(12px);
        box-shadow: 0 12px 35px rgba(0,0,0,.25);
    }

    .warning-icon {
        font-size: 3.5rem;
        margin-bottom: 14px;
    }

    .warning-title {
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .warning-text {
        color: var(--text-secondary);
        margin-bottom: 28px;
        line-height: 1.6;
    }

    .warning-buttons {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .warning-btn {
        padding: 14px 24px;
        border-radius: 14px;
        text-decoration: none;
        color: #fff;
        font-weight: 700;
        transition: .25s;
    }

    .edit-btn {
        background: linear-gradient(135deg,#f59e0b,#ef4444);
    }

    .view-btn {
        background: linear-gradient(135deg,#4f8eff,#b06cff);
    }

    .warning-btn:hover {
        transform: translateY(-2px);
    }

    @@media(max-width:768px) {

        .warning-card {
            padding: 28px 22px;
        }

        .warning-title {
            font-size: 1.6rem;
        }

        .warning-buttons {
            flex-direction: column;
        }

        .warning-btn {
            width: 100%;
        }
    }
</style>

<div class="warning-page">

    <div class="warning-card">

        <div class="warning-icon">
            ⚠️
        </div>

        <h1 class="warning-title">
            Budget Limit Exceeded!
        </h1>

        <p class="warning-text">
            Your expense has crossed the budget limit.
            Please review your expense records.
        </p>

        <div class="warning-buttons">

            <a asp-controller="Expense"
                   asp-action="DisplayExpense"
                   class="warning-btn view-btn">
                📊 View Expenses
            </a>

        </div>

    </div>

</div>
