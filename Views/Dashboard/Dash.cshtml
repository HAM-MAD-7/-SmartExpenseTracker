<style>
    .dashboard-wrapper {
        padding: 25px 0 50px;
    }

    /* HERO */

    .dashboard-hero {
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 16px;
        padding: 40px 25px;
        text-align: center;
    }

    .dashboard-badge {
        display: inline-block;
        padding: 8px 14px;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 20px;
        color: #cbd5e1;
        font-size: .9rem;
        margin-bottom: 15px;
    }

    .dashboard-title {
        font-size: 2.3rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 10px;
    }

        .dashboard-title span {
            color: #60a5fa;
        }

    .dashboard-desc {
        color: #cbd5e1;
    }

    /* ACTION CARDS */

    .manage-income-card,
    .manage-expense-card {
        margin-top: 25px;
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 14px;
        padding: 25px;
        text-align: center;
    }

        .manage-income-card h1,
        .manage-expense-card h1 {
            color: #f8fafc;
            font-size: 1.7rem;
            margin-bottom: 20px;
        }

    /* BUTTONS */

    .dashboard-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .action-btn {
        text-decoration: none;
        color: white;
        font-weight: 600;
        padding: 12px 22px;
        border-radius: 10px;
        display: inline-block;
    }

    .add-btn {
        background: #16a34a;
    }

    .view-btn {
        background: #2563eb;
    }

    .expense-add-btn {
        background: #f59e0b;
    }

    .expense-view-btn {
        background: #dc2626;
    }

    /* STATS */

    .dashboard-grid {
        margin-top: 25px;
        display: grid;
        gap: 15px;
    }

    .dashboard-card {
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 14px;
        padding: 22px;
    }

        .dashboard-card h3 {
            color: #cbd5e1;
            font-size: 1rem;
            margin-bottom: 8px;
        }

        .dashboard-card h2 {
            color: #f8fafc;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    /* Color Indicators */

    .income {
        border-left: 4px solid #16a34a;
    }

    .expense {
        border-left: 4px solid #dc2626;
    }

    .balance {
        border-left: 4px solid #2563eb;
    }

    /* MOBILE */

    @@media (max-width: 768px) {

        .dashboard-title {
            font-size: 1.9rem;
        }

        .dashboard-hero {
            padding: 30px 18px;
        }

        .dashboard-actions {
            flex-direction: column;
            align-items: center;
        }

        .action-btn {
            width: 100%;
            max-width: 260px;
            text-align: center;
        }

        .manage-income-card h1,
        .manage-expense-card h1 {
            font-size: 1.4rem;
        }

        .dashboard-card {
            text-align: center;
        }

            .dashboard-card h2 {
                font-size: 1.5rem;
            }
    }
</style>

@model SmartExpenseTracker.ViewModel.Dashboard
<div class="dashboard-wrapper">

    <!-- HERO CARD -->
    <div class="dashboard-hero">

        <div class="dashboard-badge">
            👋 Welcome Back
        </div>

        <h1 class="dashboard-title">
            Hello, <span>@Model.FullName</span>
        </h1>

        <p class="dashboard-desc">
            Here's a quick overview of your financial activity.
        </p>

    </div>

    <div class="manage-income-card">
        <h1>Manage Income 💰</h1>
        <div class="dashboard-actions">

            <a asp-controller="Income"
                   asp-action="AddIncome"
                   class="action-btn add-btn">
                ➕ Add Income
            </a>

            <a asp-controller="Income"
                   asp-action="DisplayIncome"
                   class="action-btn view-btn">
                📊 View Income
            </a>

        </div>
    </div>

    <div class="manage-expense-card">
        <h1>Manage Expense 💸</h1>
        <div class="dashboard-actions">

            <a asp-controller="Expense"
                   asp-action="AddExpense"
                   class="action-btn expense-add-btn">
                ➕ Add Expense
            </a>

            <a asp-controller="Expense"
                   asp-action="DisplayExpense"
                   class="action-btn expense-view-btn">
                📊 View Expense
            </a>

        </div>
    </div>

    <!-- STATS -->
    <div class="dashboard-grid">

        <div class="dashboard-card income">
            <h3>Total Income</h3>
            <h2>Rs. @Model.TotalIncome.ToString("0.##")</h2>
        </div>

        <div class="dashboard-card expense">
            <h3>Total Expense</h3>
            <h2>Rs. @Model.TotalExpense.ToString("0.##")</h2>
        </div>

        <div class="dashboard-card balance">
            <h3>Balance</h3>
            <h2>Rs. @Model.Balance.ToString("0.##")</h2>
        </div>

    </div>

</div>

