@model SmartExpenseTracker.Models.ExpenseModel

<style>
    .income-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 32px 16px;
    }

    .income-card {
        width: 100%;
        max-width: 620px;
        padding: 32px;
        border-radius: 24px;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--rim);
        backdrop-filter: blur(14px);
        box-shadow: 0 12px 30px rgba(0,0,0,.25);
    }

    .income-badge {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #fff;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        box-shadow: 0 0 18px rgba(239,68,68,.25);
    }

    .income-title {
        text-align: center;
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .income-sub {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 24px;
    }

    .income-field {
        margin-bottom: 18px;
    }

        .income-field label {
            display: block;
            margin-bottom: 6px;
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 600;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            width: 100%;
            padding: 13px 14px;
            border-radius: 12px;
            border: 1px solid var(--rim-bright);
            background: rgba(255,255,255,.04);
            color: var(--text-primary);
            outline: none;
            transition: .25s;
        }

        .income-field select {
            appearance: none;
            -webkit-appearance: none;
        }

            .income-field select option {
                background: #111827;
                color: #fff;
            }

        .income-field textarea {
            min-height: 110px;
            resize: vertical;
        }

            .income-field input:focus,
            .income-field select:focus,
            .income-field textarea:focus {
                border-color: rgba(239,68,68,.45);
                box-shadow: 0 0 0 3px rgba(239,68,68,.08);
            }

    .income-btn {
        width: 100%;
        border: none;
        padding: 14px;
        border-radius: 14px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        box-shadow: 0 8px 24px rgba(239,68,68,.25);
        transition: .25s;
    }

        .income-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(239,68,68,.35);
        }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #ff6b6b;
        font-size: .82rem;
    }

    @@media(max-width:768px) {
        .income-card {
            padding: 24px;
        }

        .income-title {
            font-size: 1.6rem;
        }

        .income-badge {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }
    }
</style>

<div class="income-page">

    <div class="income-card">

        <div class="income-badge">💸</div>

        <h1 class="income-title">Add Expense</h1>

        <p class="income-sub">
            Record and manage your daily expenses.
        </p>

        <form asp-action="ReceiveAddExpense" method="post">

            <div class="income-field">
                <label asp-for="Amount">Amount</label>
                <input type="number"
                       asp-for="Amount"
                       placeholder="Enter amount" />
                <span asp-validation-for="Amount"></span>
            </div>

            <div class="income-field">
                <label asp-for="Category">Category</label>

                <select asp-for="Category">
                    <option>Food</option>
                    <option>Transport</option>
                    <option>Shopping</option>
                    <option>Bills</option>
                    <option>Education</option>
                    <option>Entertainment</option>
                    <option>Health</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="Category"></span>
            </div>

            <div class="income-field">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="4"
                          placeholder="Enter description"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="income-field">
                <label asp-for="Date">Date</label>

                <input type="date"
                       asp-for="Date" />
                <span asp-validation-for="Date"></span>
            </div>

            <button type="submit" class="income-btn">
                Add Expense
            </button>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}