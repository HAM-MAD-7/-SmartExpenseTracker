<style>
    .table-wrapper {
        padding: 24px 0 50px;
    }

    .table-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .table-header h1 {
            color: var(--text-primary);
            font-size: 2.1rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .table-header p {
            color: var(--text-secondary);
        }

    /* Table */
    .cosmic-table-container {
        overflow-x: auto;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--rim);
        border-radius: 20px;
        backdrop-filter: blur(12px);
    }

    .cosmic-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cosmic-table thead {
            background: rgba(239,68,68,.08);
        }

        .cosmic-table th {
            padding: 16px;
            text-align: left;
            color: var(--text-primary);
            font-size: .9rem;
            font-weight: 700;
            border-bottom: 1px solid var(--rim);
        }

        .cosmic-table td {
            padding: 16px;
            color: var(--text-secondary);
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

        .cosmic-table tbody tr {
            transition: .25s;
        }

            .cosmic-table tbody tr:hover {
                background: rgba(255,255,255,.025);
            }

    /* Amount */
    .amount {
        color: #f87171;
        font-weight: 700;
    }

    /* Category */
    .category-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.2);
        color: #fca5a5;
        font-size: .8rem;
    }

    /* Actions */
    .action-btn {
        text-decoration: none;
        font-weight: 600;
        transition: .25s;
    }

    .edit-btn {
        color: #60a5fa;
    }

        .edit-btn:hover {
            color: #93c5fd;
        }

    .delete-btn {
        color: #f87171;
    }

        .delete-btn:hover {
            color: #fca5a5;
        }

    .pipe {
        margin: 0 8px;
        color: rgba(255,255,255,.2);
    }

    /* Modal */
    .cosmic-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        backdrop-filter: blur(8px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
        z-index: 9999;
    }

    .hidden {
        display: none;
    }

    .cosmic-modal-box {
        width: 100%;
        max-width: 400px;
        padding: 24px;
        border-radius: 18px;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--rim);
        text-align: center;
        backdrop-filter: blur(15px);
    }

    .warning-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .cosmic-modal-box h2 {
        color: var(--text-primary);
        margin-bottom: 10px;
    }

    .cosmic-modal-box p {
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .danger-text {
        color: #f87171;
        font-weight: 700;
    }

    /* Buttons */
    .modal-actions {
        margin-top: 18px;
        display: flex;
        gap: 10px;
    }

    .btn-cancel,
    .btn-delete {
        flex: 1;
        border: none;
        border-radius: 12px;
        padding: 10px;
        cursor: pointer;
        font-weight: 700;
        transition: .25s;
    }

    .btn-cancel {
        background: rgba(255,255,255,.08);
        color: var(--text-primary);
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,.12);
        }

    .btn-delete {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

        .btn-delete:hover {
            transform: translateY(-2px);
        }

    /* Mobile */
    @@media (max-width:768px) {

        .table-header h1 {
            font-size: 1.7rem;
        }

        .cosmic-table th,
        .cosmic-table td {
            padding: 13px;
            font-size: .85rem;
        }

        .action-btn {
            display: block;
            margin: 4px 0;
        }

        .pipe {
            display: none;
        }

        .modal-actions {
            flex-direction: column;
        }
    }
</style>

@model List<SmartExpenseTracker.Models.ExpenseModel>

<div class="table-wrapper">

    <div class="table-header">
        <h1>💸 Expense Records</h1>
        <p>Manage and track all your expense entries.</p>
    </div>

    <div class="cosmic-table-container">

        <table class="cosmic-table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Amount</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var exp in Model)
                {
                    <tr>

                        <td>@exp.ExpenseId</td>

                        <td class="amount">
                            Rs. @exp.Amount.ToString("0.##")
                        </td>

                        <td>
                            <span class="category-badge">
                                @exp.Category
                            </span>
                        </td>

                        <td>@exp.Description</td>

                        <td>
                            @exp.Date.ToString("yyyy-MM-dd")
                        </td>

                        <td>

                            <a asp-controller="Expense"
                                   asp-action="EditExpense"
                                   asp-route-id="@exp.ExpenseId"
                                   class="action-btn edit-btn">
                                ✏ Edit
                            </a>

                            <span class="pipe">|</span>

                            <a href="javascript:void(0);"
                                   class="action-btn delete-btn"
                                   onclick="openDeleteModal(@exp.ExpenseId)">
                                🗑 Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div id="cosmicDeleteModal" class="cosmic-modal hidden">

    <div class="cosmic-modal-box">

        <div class="warning-icon">⚠</div>

        <h2>Confirm Deletion</h2>

        <p>
            This record will be permanently removed from your expense timeline.
            <br />
            <span class="danger-text">This action cannot be undone.</span>
        </p>

        <form id="deleteForm" method="post">
            <input type="hidden" id="deleteIncomeId" name="id" />

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">
                    Cancel
                </button>

                <button type="submit" class="btn-delete">
                    Confirm Delete
                </button>
            </div>
        </form>

    </div>

</div>

<script>
    function openDeleteModal(id) {
        document.getElementById("deleteIncomeId").value = id;
        document.getElementById("deleteForm").action = '/Expense/DeleteExpense/' + id;
        document.getElementById("cosmicDeleteModal").classList.remove("hidden");
    }

    function closeDeleteModal() {
        document.getElementById("cosmicDeleteModal").classList.add("hidden");
    }

    window.onclick = function (event) {
        const modal = document.getElementById("cosmicDeleteModal");
        if (event.target === modal) {
            closeDeleteModal();
        }
    }
</script>