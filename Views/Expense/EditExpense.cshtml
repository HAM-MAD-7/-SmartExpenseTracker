<style>
    .income-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 16px;
    }

    .income-card {
        width: 100%;
        max-width: 650px;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--rim);
        border-radius: 28px;
        padding: 40px;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 24px 60px rgba(0,0,0,.45), 0 0 80px rgba(79,142,255,.08);
        position: relative;
        overflow: hidden;
    }

        .income-card::before {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            top: -120px;
            right: -100px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(79,142,255,.35), transparent 70%);
            filter: blur(50px);
        }

        .income-card::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            bottom: -100px;
            left: -80px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(176,108,255,.30), transparent 70%);
            filter: blur(50px);
        }

    .income-badge {
        width: 65px;
        height: 65px;
        margin: auto;
        margin-bottom: 20px;
        border-radius: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
        background: linear-gradient( 135deg, var(--plasma), var(--neon));
        box-shadow: 0 0 30px rgba(79,142,255,.45);
    }

    .income-badge {
        background: linear-gradient( 135deg, #f59e0b, #ef4444);
    }

    .income-title {
        text-align: center;
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .income-sub {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .income-field {
        margin-bottom: 20px;
    }

        .income-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            width: 100%;
            background: rgba(255,255,255,.05);
            border: 1px solid var(--rim-bright);
            border-radius: 14px;
            padding: 14px 16px;
            color: var(--text-primary);
            outline: none;
            transition: .3s;
        }

            .income-field select option {
                background: #111827;
                color: var(--text-primary);
            }

        .income-field select {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
        }

        .income-field textarea {
            resize: vertical;
            min-height: 120px;
        }

            .income-field input:focus,
            .income-field select:focus,
            .income-field textarea:focus {
                border-color: rgba(79,142,255,.6);
                box-shadow: 0 0 0 4px rgba(79,142,255,.10), 0 0 25px rgba(79,142,255,.15);
                background: rgba(79,142,255,.06);
            }

    .income-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 16px;
        cursor: pointer;
        color: white;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(135deg, #f59e0b, #ef4444);
        box-shadow: 0 10px 30px rgba(239,68,68,.35);
        transition: .3s;
    }

        .income-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 45px rgba(239,68,68,.45), 0 0 60px rgba(245,158,11,.25);
        }

    .field-validation-error {
        color: #ff6b6b;
        font-size: .85rem;
        display: block;
        margin-top: 6px;
        font-weight: 600;
        text-shadow: 0 0 12px rgba(255,107,107,.4);
    }

    @@media(max-width:768px) {

        .income-card {
            padding: 28px;
        }

        .income-title {
            font-size: 1.7rem;
        }
    }
</style>

@model SmartExpenseTracker.Models.ExpenseModel

<div class="income-page">

    <div class="income-card">

        <div class="income-badge">✏️</div>

        <h1 class="income-title">Edit Expense</h1>

        <p class="income-sub">
            Update your expense information.
        </p>

        <form asp-action="ReceiveEditExpense" method="post">

            <input asp-for="ExpenseId" type="hidden" />

            <div class="income-field">
                <label asp-for="Amount">Amount</label>
                <input name="Amount" type="number" value="@Model.Amount.ToString("0.##")"/>
                <span asp-validation-for="Amount"></span>
            </div>

            <div class="income-field">
                <label asp-for="Category">Category</label>

                <select asp-for="Category">

                    <option value="Food">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Bills">Bills</option>
                    <option value="Education">Education</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Health">Health</option>
                    <option value="Other">Other</option>

                </select>
                <span asp-validation-for="Category"></span>
            </div>

            <div class="income-field">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="4"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="income-field">
                <label asp-for="Date">Date</label>

                <input asp-for="Date"
                       type="date" />
                <span asp-validation-for="Date"></span>
            </div>

            <button type="submit" class="income-btn">
                Save Changes
            </button>

        </form>

    </div>

</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}