<style>
    .income-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 16px;
    }

    .income-card {
        width: 100%;
        max-width: 620px;
        padding: 32px;
        border-radius: 22px;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--rim);
        backdrop-filter: blur(12px);
    }

    .income-badge {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #fff;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
    }

    .income-title {
        text-align: center;
        color: var(--text-primary);
        font-size: 1.9rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .income-sub {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 26px;
    }

    .income-field {
        margin-bottom: 18px;
    }

        .income-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 600;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            width: 100%;
            padding: 13px 15px;
            border-radius: 12px;
            border: 1px solid var(--rim-bright);
            background: rgba(255,255,255,.05);
            color: var(--text-primary);
            outline: none;
            transition: .25s;
        }

        .income-field textarea {
            resize: vertical;
            min-height: 110px;
        }

        .income-field select {
            appearance: none;
            -webkit-appearance: none;
        }

            .income-field select option {
                background: #111827;
                color: var(--text-primary);
            }

            .income-field input:focus,
            .income-field select:focus,
            .income-field textarea:focus {
                border-color: rgba(239,68,68,.4);
                background: rgba(239,68,68,.04);
            }

    .income-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 14px;
        cursor: pointer;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        transition: .25s;
    }

        .income-btn:hover {
            transform: translateY(-2px);
        }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #ff6b6b;
        font-size: .85rem;
        font-weight: 600;
    }

    @@media (max-width:768px) {

        .income-card {
            padding: 24px;
        }

        .income-title {
            font-size: 1.6rem;
        }

        .income-badge {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            padding: 12px 14px;
        }
    }
</style>

@model SmartExpenseTracker.Models.ExpenseModel

<div class="income-page">

    <div class="income-card">

        <div class="income-badge">✏️</div>

        <h1 class="income-title">Edit Expense</h1>

        <p class="income-sub">
            Update your expense information.
        </p>

        <form asp-action="ReceiveEditExpense" method="post">

            <input asp-for="ExpenseId" type="hidden" />

            <div class="income-field">
                <label asp-for="Amount">Amount</label>
                <input name="Amount" type="number" value="@Model.Amount.ToString("0.##")"/>
                <span asp-validation-for="Amount"></span>
            </div>

            <div class="income-field">
                <label asp-for="Category">Category</label>

                <select asp-for="Category">

                    <option value="Food">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Bills">Bills</option>
                    <option value="Education">Education</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Health">Health</option>
                    <option value="Other">Other</option>

                </select>
                <span asp-validation-for="Category"></span>
            </div>

            <div class="income-field">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="4"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="income-field">
                <label asp-for="Date">Date</label>

                <input asp-for="Date"
                       type="date" />
                <span asp-validation-for="Date"></span>
            </div>

            <button type="submit" class="income-btn">
                Save Changes
            </button>

        </form>

    </div>

</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}