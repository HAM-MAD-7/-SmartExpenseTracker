<style>

    .hero-section {
        position: relative;
        overflow: hidden;
        border-radius: 32px;
        padding: 80px 50px;
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#312e81 100%);
        color: white;
        box-shadow: 0 30px 80px rgba(15,23,42,.25);
        margin-top: 20px;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,.06);
            border-radius: 50%;
            top: -150px;
            right: -120px;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(99,102,241,.25);
            border-radius: 50%;
            bottom: -120px;
            left: -100px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .hero-badge {
        display: inline-block;
        padding: 10px 20px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.15);
        backdrop-filter: blur(10px);
        border-radius: 50px;
        font-size: .9rem;
        margin-bottom: 25px;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 20px;
    }

        .hero-title span {
            background: linear-gradient(90deg,#06b6d4,#38bdf8,#818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-description {
        max-width: 750px;
        margin: auto;
        font-size: 1.15rem;
        color: rgba(255,255,255,.85);
        line-height: 1.8;
    }

    .hero-buttons {
        margin-top: 35px;
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-modern {
        text-decoration: none;
        padding: 15px 28px;
        border-radius: 14px;
        font-weight: 700;
        transition: .35s ease;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: white;
        box-shadow: 0 15px 35px rgba(99,102,241,.35);
    }

        .btn-primary-modern:hover {
            transform: translateY(-4px);
            color: white;
        }

    .btn-outline-modern {
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.08);
        color: white;
        backdrop-filter: blur(10px);
    }

        .btn-outline-modern:hover {
            background: rgba(255,255,255,.15);
            color: white;
            transform: translateY(-4px);
        }

    .features-section {
        margin-top: 80px;
    }

    .section-title {
        text-align: center;
        font-size: 2.6rem;
        font-weight: 800;
        color: #F8FAFC;
        margin-bottom: 15px;
        text-shadow: 0 0 25px rgba(192,132,252,.5);
    }

    .section-subtitle {
        text-align: center;
        color: #CBD5E1;
        max-width: 700px;
        margin: auto auto 50px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
        gap: 25px;
    }

    .feature-card {
        background: linear-gradient(135deg, #0f172a, #1e1b4b);
        padding: 35px;
        border-radius: 24px;
        box-shadow: 0 15px 40px rgba(79,70,229,.25);
        transition: .4s ease;
        border: 1px solid rgba(139,92,246,.35);
    }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(168,85,247,.45);
        }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        color: #C084FC;
        text-shadow: 0 0 25px rgba(192,132,252,.7);
    }

    .feature-card h3 {
        font-weight: 700;
        color: #F8FAFC;
        margin-bottom: 10px;
    }

    .feature-card p {
        color: #CBD5E1;
        line-height: 1.7;
    }

    .stats-section {
        margin-top: 80px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 25px;
    }

    .stat-card {
        background: linear-gradient(135deg, #0f172a, #1e1b4b);
        border: 1px solid rgba(139, 92, 246, .35);
        border-radius: 24px;
        padding: 35px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(79, 70, 229, .35);
        transition: .35s;
    }

        .stat-card:hover {
            transform: scale(1.04);
            box-shadow: 0 20px 55px rgba(168, 85, 247, .55);
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #C084FC;
        text-shadow: 0 0 25px rgba(192, 132, 252, .7);
    }

    .stat-label {
        color: #CBD5E1;
        margin-top: 8px;
    }

    @@media(max - width:768px) {

        .hero-section {
            padding: 60px 25px;
        }

        .hero-title {
            font-size: 2.4rem;
        }

        .section-title {
            font-size: 2rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

        .btn-modern {
            width: 100%;
        }
    }
</style>
<section class="hero-section">
    <div class="hero-content">

        <div class="hero-badge">
            💰 Smart Financial Management Platform
        </div>

        <h1 class="hero-title">
            Control Your <span>Income & Expenses</span> Like a Pro
        </h1>

        <p class="hero-description">
            Smart Expense Tracker helps you monitor income, track expenses,
            manage budgets, analyze spending habits, and gain complete control
            over your personal finances through a simple and modern experience.
        </p>

        <div class="hero-buttons">

            <a asp-controller="User"
                   asp-action="Register"
                   class="btn-modern btn-primary-modern">
                Get Started
            </a>

            <a asp-controller="User"
                   asp-action="Login"
                   class="btn-modern btn-outline-modern">
                Login Account
            </a>

        </div>

    </div>

</section>

<section class="features-section">

    <h2 class="section-title">
        Powerful Features
    </h2>

    <p class="section-subtitle">
        Everything you need to efficiently manage your personal finances.
    </p>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">💵</div>
            <h3>Manage Income</h3>
            <p>
                Add, edit, delete and view all income records with complete accuracy.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">💳</div>
            <h3>Track Expenses</h3>
            <p>
                Record daily expenses and monitor where your money is being spent.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Financial Reports</h3>
            <p>
                Analyze your transactions and gain valuable financial insights.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Secure Records</h3>
            <p>
                Keep all your financial data organized and securely managed.
            </p>
        </div>

    </div>

</section>


<section class="stats-section">

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-number">24/7</div>
            <div class="stat-label">Expense Monitoring</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Financial Visibility</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">∞</div>
            <div class="stat-label">Income Records</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">⚡</div>
            <div class="stat-label">Fast Management</div>
        </div>

    </div>

</section>
