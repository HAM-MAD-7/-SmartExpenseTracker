<style>

    .hero-section {
        background: #1e293b;
        border-radius: 16px;
        padding: 60px 30px;
        text-align: center;
        margin-top: 20px;
        border: 1px solid #334155;
    }

    .hero-content {
        max-width: 900px;
        margin: auto;
    }

    .hero-badge {
        display: inline-block;
        background: #2563eb;
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: .9rem;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 800;
        color: white;
        margin-bottom: 20px;
        line-height: 1.2;
    }

        .hero-title span {
            color: #60a5fa;
        }

    .hero-description {
        color: #cbd5e1;
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 700px;
        margin: auto;
    }

    .hero-buttons {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .btn-modern {
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-primary-modern {
        background: #2563eb;
        color: white;
    }

        .btn-primary-modern:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-outline-modern {
        background: #374151;
        color: white;
    }

        .btn-outline-modern:hover {
            background: #4b5563;
            color: white;
        }

    .features-section {
        margin-top: 60px;
    }

    .section-title {
        text-align: center;
        color: white;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .section-subtitle {
        text-align: center;
        color: #cbd5e1;
        max-width: 700px;
        margin: auto auto 40px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 20px;
    }

    .feature-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 25px;
    }

    .feature-icon {
        font-size: 2rem;
        margin-bottom: 15px;
    }

    .feature-card h3 {
        color: white;
        margin-bottom: 10px;
        font-size: 1.2rem;
    }

    .feature-card p {
        color: #cbd5e1;
        line-height: 1.7;
    }

    .stats-section {
        margin-top: 60px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 20px;
    }

    .stat-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        color: #60a5fa;
    }

    .stat-label {
        margin-top: 8px;
        color: #cbd5e1;
    }

    @@media(max - width:768px) {

        .hero-section {
            padding: 40px 20px;
        }

        .hero-title {
            font-size: 2rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

        .btn-modern {
            width: 100%;
        }

        .section-title {
            font-size: 1.7rem;
        }
    }
    }
</style>
<section class="hero-section">
    <div class="hero-content">

        <div class="hero-badge">
            💰 Smart Financial Management Platform
        </div>

        <h1 class="hero-title">
            Control Your <span>Income & Expenses</span> Like a Pro
        </h1>

        <p class="hero-description">
            Smart Expense Tracker helps you monitor income, track expenses,
            manage budgets, analyze spending habits, and gain complete control
            over your personal finances through a simple and modern experience.
        </p>

        <div class="hero-buttons">

            <a asp-controller="User"
                   asp-action="Register"
                   class="btn-modern btn-primary-modern">
                Get Started
            </a>

            <a asp-controller="User"
                   asp-action="Login"
                   class="btn-modern btn-outline-modern">
                Login Account
            </a>

        </div>

    </div>

</section>

<section class="features-section">

    <h2 class="section-title">
        Powerful Features
    </h2>

    <p class="section-subtitle">
        Everything you need to efficiently manage your personal finances.
    </p>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">💵</div>
            <h3>Manage Income</h3>
            <p>
                Add, edit, delete and view all income records with complete accuracy.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">💳</div>
            <h3>Track Expenses</h3>
            <p>
                Record daily expenses and monitor where your money is being spent.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Financial Reports</h3>
            <p>
                Analyze your transactions and gain valuable financial insights.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Secure Records</h3>
            <p>
                Keep all your financial data organized and securely managed.
            </p>
        </div>

    </div>

</section>


<section class="stats-section">

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-number">24/7</div>
            <div class="stat-label">Expense Monitoring</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Financial Visibility</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">∞</div>
            <div class="stat-label">Income Records</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">⚡</div>
            <div class="stat-label">Fast Management</div>
        </div>

    </div>

</section>
