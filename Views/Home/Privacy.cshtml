<style>

    .privacy-wrapper {
        padding: 40px 0 70px;
        position: relative;
        z-index: 2;
    }

    .privacy-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        padding: 80px 50px;
        text-align: center;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--rim);
        backdrop-filter: blur(20px);
        box-shadow: 0 24px 60px rgba(0,0,0,.45), 0 0 80px rgba(79,142,255,.08);
        transform: translateZ(0);
    }

        .privacy-hero::before,
        .privacy-hero::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: .4;
        }

        .privacy-hero::before {
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, var(--plasma), transparent 70%);
            top: -120px;
            right: -100px;
        }

        .privacy-hero::after {
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, var(--neon), transparent 70%);
            bottom: -120px;
            left: -80px;
        }

    .privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        background: rgba(255,255,255,.06);
        border: 1px solid var(--rim-bright);
        color: var(--text-secondary);
        font-size: .85rem;
        margin-bottom: 18px;
    }

    .privacy-title {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -.03em;
        color: var(--text-primary);
    }

        .privacy-title span {
            background: linear-gradient(90deg, var(--plasma), var(--aurora));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .privacy-description {
        max-width: 820px;
        margin: 18px auto 0;
        color: var(--text-secondary);
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .privacy-content {
        margin-top: 50px;
        display: grid;
        gap: 18px;
    }

    .privacy-card {
        background: rgba(255,255,255,.04);
        border: 1px solid var(--rim);
        border-radius: var(--radius-lg);
        padding: 28px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
        transition: all .35s var(--ease-out);
    }

        .privacy-card:hover {
            transform: translateY(-6px);
            border-color: var(--rim-bright);
            box-shadow: 0 32px 80px rgba(0,0,0,.5), 0 0 50px rgba(79,142,255,.08);
        }

        .privacy-card h3 {
            color: var(--text-primary);
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .privacy-card p {
            color: var(--text-secondary);
            line-height: 1.7;
        }

    .security-banner {
        margin-top: 35px;
        border-radius: var(--radius-xl);
        padding: 30px;
        background: linear-gradient(135deg, rgba(16,185,129,.15), rgba(79,142,255,.10) );
        border: 1px solid var(--rim-bright);
        backdrop-filter: blur(18px);
        text-align: center;
        box-shadow: 0 24px 60px rgba(0,0,0,.4);
    }

        .security-banner h2 {
            color: var(--text-primary);
            font-weight: 800;
        }

        .security-banner p {
            color: var(--text-secondary);
        }

    @@media (max-width: 768px) {
        .privacy-hero {
            padding: 50px 22px;
        }

        .privacy-title {
            font-size: 2.2rem;
        }

        .privacy-card {
            padding: 22px;
        }
    }

    @@media (max-width: 480px) {
        .privacy-title {
            font-size: 1.8rem;
        }
    }

    .security-banner {
        margin-top: 40px;
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        padding: 32px 28px;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--rim-bright);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        text-align: center;
        box-shadow: 0 24px 60px rgba(0,0,0,.45), 0 0 70px rgba(16,185,129,.10);
        transition: all .35s var(--ease-out);
    }

        .security-banner::before {
            content: '';
            position: absolute;
            inset: -40%;
            background: radial-gradient(circle, rgba(16,185,129,.25), transparent 60% );
            filter: blur(60px);
            opacity: .6;
            z-index: 0;
        }

        .security-banner > * {
            position: relative;
            z-index: 1;
        }

        .security-banner h2 {
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 10px;
            letter-spacing: -.02em;
        }

        .security-banner p {
            margin: 0;
            color: var(--text-secondary);
            line-height: 1.8;
            font-size: 1rem;
        }

        .security-banner:hover {
            transform: translateY(-6px);
            border-color: var(--rim);
            box-shadow: 0 32px 80px rgba(0,0,0,.55), 0 0 90px rgba(16,185,129,.18);
        }

    @@media(max - width:768px) {

        .privacy-hero {
            padding: 55px 25px;
        }

        .privacy-title {
            font-size: 2.3rem;
        }

        .privacy-description {
            font-size: 1rem;
        }

        .privacy-card {
            padding: 25px;
        }
    }

    @@media(max - width:480px) {

        .privacy-title {
            font-size: 1.9rem;
        }

        .privacy-badge {
            font-size: .85rem;
        }
    }
</style>

<div class="privacy-wrapper">


    <section class="privacy-hero">

        <div class="privacy-badge">
