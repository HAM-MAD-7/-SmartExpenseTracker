<style>

    .privacy-wrapper {
        padding: 30px 0 50px;
    }

    .privacy-hero {
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 16px;
        padding: 50px 30px;
        text-align: center;
        margin-bottom: 30px;
    }

    .privacy-badge {
        display: inline-block;
        padding: 8px 14px;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 20px;
        font-size: .9rem;
        color: #cbd5e1;
        margin-bottom: 15px;
    }

    .privacy-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 15px;
    }

        .privacy-title span {
            color: #60a5fa;
        }

    .privacy-description {
        max-width: 800px;
        margin: auto;
        color: #cbd5e1;
        line-height: 1.7;
    }

    .privacy-content {
        display: grid;
        gap: 18px;
    }

    .privacy-card {
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 12px;
        padding: 24px;
    }

        .privacy-card h3 {
            color: #f8fafc;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .privacy-card p {
            color: #cbd5e1;
            line-height: 1.7;
            margin: 0;
        }

    .security-banner {
        margin-top: 30px;
        background: #0f172a;
        border: 1px solid #2d3748;
        border-radius: 16px;
        padding: 28px;
        text-align: center;
    }

        .security-banner h2 {
            color: #f8fafc;
            margin-bottom: 10px;
            font-size: 1.5rem;
        }

        .security-banner p {
            color: #cbd5e1;
            line-height: 1.7;
            margin: 0;
        }

    @@media (max-width: 768px) {

        .privacy-hero {
            padding: 35px 20px;
        }

        .privacy-title {
            font-size: 2rem;
        }

        .privacy-card {
            padding: 20px;
        }

        .security-banner {
            padding: 22px;
        }
    }

    @@media (max-width: 480px) {

        .privacy-title {
            font-size: 1.7rem;
        }

        .privacy-description {
            font-size: .95rem;
        }
    }
</style>

<div class="privacy-wrapper">


    <section class="privacy-hero">

        <div class="privacy-badge">
            🔒 Your Data Matters
        </div>

        <h1 class="privacy-title">
            Privacy <span>Policy</span>
        </h1>

        <p class="privacy-description">
            At Smart Expense Tracker, protecting your personal and financial
            information is a top priority. This Privacy Policy explains how
            we collect, use, store, and safeguard your data while you manage
            your income and expenses through our platform.
        </p>

    </section>


    <section class="privacy-content">

        <div class="privacy-card">
            <h3>📋 Information We Collect</h3>
            <p>
                We collect only the information necessary to provide our
                services, including account details, income records,
                expense entries, and user preferences.
            </p>
        </div>

        <div class="privacy-card">
            <h3>🔐 Data Protection</h3>
            <p>
                Your information is protected using secure storage methods
                and modern security practices designed to prevent unauthorized
                access or misuse.
            </p>
        </div>

        <div class="privacy-card">
            <h3>📊 How We Use Your Data</h3>
            <p>
                Data is used exclusively to provide financial tracking,
                generate reports, improve user experience, and maintain
                system functionality.
            </p>
        </div>

        <div class="privacy-card">
            <h3>🚫 No Unauthorized Sharing</h3>
            <p>
                We do not sell, rent, or share your personal financial
                information with third parties without your consent,
                except when required by law.
            </p>
        </div>

    </section>

    <section class="security-banner">

        <h2>🛡️ Secure Financial Management</h2>

        <p>
            Smart Expense Tracker is committed to maintaining the confidentiality,
            integrity, and security of your financial records so you can focus
            on managing your money with confidence.
        </p>

    </section>

</div>


