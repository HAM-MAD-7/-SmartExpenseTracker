@model SmartExpenseTracker.Models.IncomeModel

<style>
    .income-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 15px;
    }

    .income-card {
        width: 100%;
        max-width: 600px;
        background: #111827;
        border: 1px solid #2d3748;
        border-radius: 16px;
        padding: 30px;
    }

    .income-badge {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
    }

    .income-title {
        text-align: center;
        color: #f8fafc;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .income-sub {
        text-align: center;
        color: #cbd5e1;
        margin-bottom: 25px;
    }

    .income-field {
        margin-bottom: 18px;
    }

        .income-field label {
            display: block;
            margin-bottom: 6px;
            color: #cbd5e1;
            font-weight: 600;
            font-size: .9rem;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            width: 100%;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #374151;
            background: #1f2937;
            color: #f8fafc;
            outline: none;
        }

            .income-field input:focus,
            .income-field select:focus,
            .income-field textarea:focus {
                border-color: #2563eb;
            }

        .income-field textarea {
            resize: vertical;
            min-height: 100px;
        }

        .income-field select option {
            background: #1f2937;
            color: #f8fafc;
        }

    .income-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

        .income-btn:hover {
            background: #1d4ed8;
        }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #ef4444;
        font-size: .85rem;
        font-weight: 500;
    }

    @@media (max-width: 768px) {

        .income-card {
            padding: 22px;
        }

        .income-title {
            font-size: 1.5rem;
        }

        .income-badge {
            width: 52px;
            height: 52px;
            font-size: 24px;
        }
    }
</style>

<div class="income-page">

    <div class="income-card">

        <div class="income-badge">💰</div>

        <h1 class="income-title">Add Income</h1>

        <p class="income-sub">
            Record and manage your income sources.
        </p>

        <form asp-action="ReceiveAddIncome" method="post">

            <div class="income-field">
                <label asp-for="Amount">Amount</label>
                <input type="number"
                       asp-for="Amount"
                       placeholder="Enter amount" />
                <span asp-validation-for="Amount"></span>
            </div>

            <div class="income-field">
                <label asp-for="Category">Category</label>

                <select asp-for="Category">
                    <option>Salary</option>
                    <option>Business</option>
                    <option>Freelance</option>
                    <option>Investment</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="Category"></span>
            </div>

            <div class="income-field">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="4"
                          placeholder="Enter description"></textarea>
                 <span asp-validation-for="Description"></span>
            </div>

            <div class="income-field">
                <label asp-for="Date">Date</label>

                <input type="date"
                       asp-for="Date" />
                <span asp-validation-for="Date"></span>
            </div>

            <button type="submit" class="income-btn">
                Add Income
            </button>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}