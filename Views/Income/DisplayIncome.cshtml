@model List<SmartExpenseTracker.Models.IncomeModel>

<style>
    /* =========================
       LIGHTWEIGHT COSMIC TABLE
    ========================= */

    .table-wrapper {
        padding: 20px 0 40px;
    }

    .table-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .table-header h1 {
            color: var(--text-primary);
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .table-header p {
            color: var(--text-secondary);
        }

    /* TABLE */

    .cosmic-table-container {
        overflow-x: auto;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--rim);
        border-radius: 18px;
        backdrop-filter: blur(8px);
    }

    .cosmic-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

        .cosmic-table thead {
            background: rgba(255,255,255,.04);
        }

        .cosmic-table th {
            padding: 16px;
            color: var(--text-primary);
            font-size: .9rem;
            font-weight: 600;
            border-bottom: 1px solid var(--rim);
        }

        .cosmic-table td {
            padding: 16px;
            color: var(--text-secondary);
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

        .cosmic-table tbody tr {
            transition: .25s ease;
        }

            .cosmic-table tbody tr:hover {
                background: rgba(255,255,255,.03);
            }

    /* BADGES */

    .amount {
        color: #10b981;
        font-weight: 700;
    }

    .category-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: rgba(79,142,255,.12);
        color: #8ab4ff;
        font-size: .8rem;
    }

    /* ACTIONS */

    .action-btn {
        text-decoration: none;
        font-weight: 600;
        transition: .25s;
    }

    .edit-btn {
        color: #60a5fa;
    }

        .edit-btn:hover {
            color: #93c5fd;
        }

    .delete-btn {
        color: #f87171;
    }

        .delete-btn:hover {
            color: #fca5a5;
        }

    .pipe {
        margin: 0 8px;
        color: rgba(255,255,255,.2);
    }

    /* MODAL */

    .cosmic-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.75);
        backdrop-filter: blur(6px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .hidden {
        display: none;
    }

    .cosmic-modal-box {
        width: 400px;
        max-width: 90%;
        padding: 24px;
        border-radius: 18px;
        background: rgba(20,20,30,.95);
        border: 1px solid var(--rim);
        text-align: center;
    }

    .warning-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .cosmic-modal-box h2 {
        color: var(--text-primary);
        margin-bottom: 10px;
    }

    .cosmic-modal-box p {
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .danger-text {
        color: #f87171;
        font-weight: 700;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-cancel,
    .btn-delete {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-cancel {
        background: rgba(255,255,255,.08);
        color: white;
    }

    .btn-delete {
        background: #ef4444;
        color: white;
    }

    /* MOBILE */

    @@media (max-width:768px) {

        .table-header h1 {
            font-size: 1.7rem;
        }

        .cosmic-table th,
        .cosmic-table td {
            padding: 12px;
            font-size: .85rem;
        }

        .modal-actions {
            flex-direction: column;
        }

        .pipe {
            display: none;
        }
    }
</style>

<div class="table-wrapper">

    <div class="table-header">
        <h1>💰 Income Records</h1>
        <p>Manage and track all your income entries.</p>
    </div>

    <div class="cosmic-table-container">

        <table class="cosmic-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Amount</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var incs in Model)
                {
                    <tr>
                        <td>@incs.IncomeId</td>

                        <td class="amount">
                            Rs. @incs.Amount.ToString("0.##")
                        </td>

                        <td>
                            <span class="category-badge">
                                @incs.Category
                            </span>
                        </td>

                        <td>@incs.Description</td>

                        <td>@incs.Date.ToString("yyyy-MM-dd")</td>

                        <td>
                            <a asp-action="EditIncome"
                               asp-route-id="@incs.IncomeId"
                               class="action-btn edit-btn">
                                ✏ Edit
                            </a>

                            <span class="pipe">|</span>

                            <a href="javascript:void(0);"
                               class="action-btn delete-btn"
                               onclick="openDeleteModal(@incs.IncomeId)">
                                🗑 Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<div id="cosmicDeleteModal" class="cosmic-modal hidden">

    <div class="cosmic-modal-box">

        <div class="warning-icon">⚠</div>

        <h2>Confirm Deletion</h2>

        <p>
            This record will be permanently removed from your income timeline.
            <br />
            <span class="danger-text">This action cannot be undone.</span>
        </p>

        <form id="deleteForm" method="post">
            <input type="hidden" id="deleteIncomeId" name="id" />

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">
                    Cancel
                </button>

                <button type="submit" class="btn-delete">
                    Confirm Delete
                </button>
            </div>
        </form>

    </div>

</div>

<script>
    function openDeleteModal(id) {
        document.getElementById("deleteIncomeId").value = id;
        document.getElementById("deleteForm").action = '/Income/DeleteIncome/' + id;
        document.getElementById("cosmicDeleteModal").classList.remove("hidden");
    }

    function closeDeleteModal() {
        document.getElementById("cosmicDeleteModal").classList.add("hidden");
    }

    window.onclick = function (event) {
        const modal = document.getElementById("cosmicDeleteModal");
        if (event.target === modal) {
            closeDeleteModal();
        }
    }
</script>