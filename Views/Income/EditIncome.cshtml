<style>
    .income-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 15px;
    }

    .income-card {
        width: 100%;
        max-width: 600px;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--rim);
        border-radius: 20px;
        padding: 30px;
        backdrop-filter: blur(8px);
    }

    .income-badge {
        width: 60px;
        height: 60px;
        margin: 0 auto 18px;
        border-radius: 14px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 26px;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
    }

    .income-title {
        text-align: center;
        color: var(--text-primary);
        font-size: 1.9rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .income-sub {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 25px;
    }

    .income-field {
        margin-bottom: 18px;
    }

        .income-field label {
            display: block;
            margin-bottom: 6px;
            color: var(--text-secondary);
            font-size: .85rem;
            font-weight: 600;
        }

        .income-field input,
        .income-field select,
        .income-field textarea {
            width: 100%;
            padding: 13px 15px;
            border-radius: 12px;
            border: 1px solid var(--rim-bright);
            background: rgba(255,255,255,.04);
            color: var(--text-primary);
            outline: none;
            transition: .25s;
        }

        .income-field textarea {
            resize: vertical;
            min-height: 110px;
        }

            .income-field input:focus,
            .income-field select:focus,
            .income-field textarea:focus {
                border-color: rgba(79,142,255,.5);
                background: rgba(255,255,255,.06);
            }

        .income-field select {
            appearance: none;
        }

            .income-field select option {
                background: #111827;
                color: #fff;
            }

    .income-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        background: linear-gradient(135deg,#f59e0b,#ef4444);
        transition: .25s;
    }

        .income-btn:hover {
            opacity: .9;
        }

    .field-validation-error {
        color: #ef4444;
        font-size: .85rem;
        display: block;
        margin-top: 5px;
    }

    @@media(max - width:768px) {

        .income-card {
            padding: 24px;
        }

        .income-title {
            font-size: 1.6rem;
        }
    }
</style>

@model SmartExpenseTracker.Models.IncomeModel

<div class="income-page">

    <div class="income-card">

        <div class="income-badge">✏️</div>

        <h1 class="income-title">Edit Income</h1>

        <p class="income-sub">
            Update your income information.
        </p>

        <form asp-action="ReceiveEditIncome" method="post">

            <input asp-for="IncomeId" type="hidden" />

            <div class="income-field">
                <label asp-for="Amount">Amount</label>
                <input name="Amount" value="@Model.Amount.ToString("0.##")" type="number"/>
                <span asp-validation-for="Amount"></span>
            </div>

            <div class="income-field">
                <label asp-for="Category">Category</label>

                <select asp-for="Category">

                    <option value="Salary">Salary</option>
                    <option value="Business">Business</option>
                    <option value="Freelance">Freelance</option>
                    <option value="Investment">Investment</option>
                    <option value="Other">Other</option>

                </select>
                <span asp-validation-for="Category"></span>
            </div>

            <div class="income-field">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="4"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="income-field">
                <label asp-for="Date">Date</label>

                <input asp-for="Date"
                       type="date" />
                <span asp-validation-for="Date"></span>
            </div>

            <button type="submit" class="income-btn">
                Save Changes
            </button>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}