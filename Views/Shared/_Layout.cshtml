<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartExpenseTracker</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartExpenseTracker.styles.css" asp-append-version="true" />

    <style>

        :root {
        --bg: #0f172a;
        --card: #1e293b;
        --border: #334155;
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --danger: #dc2626;
        --text: #f8fafc;
        --text-muted: #cbd5e1;
        --radius: 12px;
        }

        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        html {
        scroll-behavior: smooth;
        }

        body {
        font-family: 'DM Sans',sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        }

        .page-wrapper {
        flex: 1;
        }

        main {
        padding: 30px 0;
        }

        .navbar {
        background: #111827 !important;
        border-bottom: 1px solid var(--border);
        padding: 12px 0 !important;
        }

        .navbar-brand {
        color: white !important;
        font-family: 'Syne',sans-serif;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .brand-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--primary);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1rem;
        }

        .brand-text {
        color: white;
        }

        .navbar-nav .nav-link {
        color: var(--text-muted) !important;
        font-weight: 500;
        border-radius: 8px;
        transition: .2s;
        }

        .navbar-nav .nav-link:hover {
        color: white !important;
        }

        .nav-auth {
        display: flex;
        gap: 10px;
        align-items: center;
        }

        .btn-glass,
        .btn-plasma,
        .btn-ghost-danger {
        border: none;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
        }

        .btn-glass {
        background: #374151;
        color: white !important;
        }

        .btn-glass:hover {
        background: #4b5563;
        }

        .btn-plasma {
        background: var(--primary);
        color: white !important;
        }

        .btn-plasma:hover {
        background: var(--primary-hover);
        }

        .btn-ghost-danger {
        background: var(--danger);
        color: white !important;
        }

        .btn-ghost-danger:hover {
        opacity: .9;
        }

        .glass-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        }

        footer {
        background: #111827;
        border-top: 1px solid var(--border);
        padding: 18px 0;
        margin-top: auto;
        }

        .footer-inner {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        color: var(--text-muted);
        font-size: .9rem;
        }

        .footer-inner a {
        color: var(--text-muted);
        text-decoration: none;
        }

        .footer-inner a:hover {
        color: white;
        }

        .footer-dot {
        opacity: .5;
        }

        .navbar-toggler {
        border: 1px solid var(--border) !important;
        }

        @@media(max - width:991px) {

        .navbar-collapse {
        margin-top: 12px;
        }

        .nav-auth {
        flex-direction: column;
        align-items: stretch;
        margin-top: 12px;
        }

        .btn-glass,
        .btn-plasma,
        .btn-ghost-danger {
        width: 100%;
        text-align: center;
        }
        }

        @@media(max - width:768px) {

        .navbar-brand {
        font-size: 1rem;
        }

        .brand-icon {
        width: 32px;
        height: 32px;
        }

        main {
        padding: 20px 0;
        }
        }
    </style>
</head>

<body>

    
    <header>
        <nav class="navbar navbar-expand-lg" id="mainNav">
            <div class="container-fluid px-4">

               
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon" aria-hidden="true">💰</span>
                    <span class="brand-text">SmartExpense</span>
                </a>

              
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

              
                <div class="navbar-collapse collapse" id="navbarContent">

                    
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Dash">
                                Dashboard
                            </a>
                        </li>
                    </ul>

                    
                    <div class="nav-auth">
                        <a class="btn-ghost-danger"
                           asp-controller="User"
                           asp-action="Logout">
                            LogOut
                        </a>
                        <a class="btn-glass"
                           asp-controller="User"
                           asp-action="Register">
                            Sign Up
                        </a>
                        <a class="btn-glass btn-plasma"
                           asp-controller="User"
                           asp-action="Login">
                            Login →
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    
    <div class="page-wrapper">
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    
    <footer>
        <div class="container">
            <div class="footer-inner">
                <span>© 2026 SmartExpenseTracker</span>
                <span class="footer-dot">·</span>
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy Policy
                </a>
                <span class="footer-dot">·</span>
                <span>Built with precision</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        
        const nav = document.getElementById('mainNav');
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 20);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
