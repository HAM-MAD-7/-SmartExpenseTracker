@model SmartExpenseTracker.Models.UserModel
<style>
    :root {
        --primary: #4f8eff;
        --secondary: #b06cff;
        --bg: rgba(13,18,36,.9);
        --text: #eef1fb;
        --muted: #94a3b8;
        --border: rgba(255,255,255,.12);
    }

    .login-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .lc {
        width: 100%;
        max-width: 450px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px;
        backdrop-filter: blur(12px);
    }

    .lc-badge {
        width: 50px;
        height: 50px;
        margin: 0 auto 16px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: linear-gradient(135deg,var(--primary),var(--secondary));
    }

    .lc-title {
        text-align: center;
        color: var(--text);
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .lc-sub {
        text-align: center;
        color: var(--muted);
        font-size: .9rem;
        margin-bottom: 24px;
    }

    .lc-field {
        margin-bottom: 16px;
    }

    .lc-label {
        display: block;
        color: var(--muted);
        font-size: .8rem;
        margin-bottom: 6px;
    }

    .lc-wrap {
        position: relative;
    }

    .lc-ico {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
    }

    .lc-input {
        width: 100%;
        padding: 12px 14px 12px 44px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.05);
        color: var(--text);
        outline: none;
        box-sizing: border-box;
    }

        .lc-input:focus {
            border-color: var(--primary);
        }

    .lc-eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
    }

    .lc-extras {
        margin: 16px 0;
    }

    .lc-check {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: .85rem;
    }

    .lc-btn {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 12px;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
        background: linear-gradient(135deg,var(--primary),var(--secondary));
    }

        .lc-btn:hover {
            opacity: .95;
        }

    .lc-foot {
        text-align: center;
        margin-top: 16px;
        color: var(--muted);
        font-size: .85rem;
    }

        .lc-foot a {
            color: var(--primary);
            text-decoration: none;
        }

    .field-validation-error {
        color: #f87171;
        font-size: .75rem;
        margin-top: 4px;
        display: block;
    }

    .validation-summary-errors {
        color: #f87171;
        margin-bottom: 15px;
    }

    @@media(max - width:480px) {
        .lc {
            padding: 24px;
        }

        .lc-title {
            font-size: 1.4rem;
        }
    }
</style>

<div class="login-page">
    <div class="lc-perspective">
        <form asp-action="ReceiveLogin" method="post" class="lc">

            <div class="lc-badge" aria-hidden="true">💰</div>
            <h1 class="lc-title">Welcome back</h1>
            <p class="lc-sub">Sign in to continue managing your expenses</p>

            <div class="lc-field">
                <label class="lc-label" for="lcUser" asp-for="UserName">Username</label>
                <div class="lc-wrap">
                    <span class="lc-ico" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                        </svg>
                    </span>
                    <input id="lcUser"
                           asp-for="UserName"
                           class="lc-input"
                           type="text"
                           placeholder="Enter your username" autocomplete="username" />
                </div>
                <span asp-validation-for="UserName"></span>
            </div>

            <div class="lc-field">

    <label class="lc-label" asp-for="Password">Password</label>

    <div class="lc-wrap">

        <span class="lc-ico" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </span>

        <input asp-for="Password"
               id="lcPwd"
               class="lc-input"
               type="password"
               placeholder="Enter your password" autocomplete="current-password"/>

        <button type="button"
                class="lc-eye-btn"
                onclick="togglePassword()"
                aria-label="Toggle password visibility">

            👁

        </button>

    </div>

    <span asp-validation-for="Password" class="field-validation-error"></span>

</div>

            <div class="lc-extras">
                <label class="lc-check">
                    <input type="checkbox" name="RememberMe" />
                    <span class="lc-check-lbl">Remember me</span>
                </label>
            </div>

            <button type="submit" class="lc-btn">
                <span class="lc-btn-inner">Login to Account</span>
            </button>

            <p class="lc-foot">
                Don't have an account?
                <a asp-controller="User" asp-action="Register">Create Account</a>
            </p>

        </form>
    </div>
</div>

@section Scripts {
<script>
function togglePassword() {
    const input = document.getElementById("lcPwd");

    input.type = input.type === "password"
        ? "text"
        : "password";
}
</script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
