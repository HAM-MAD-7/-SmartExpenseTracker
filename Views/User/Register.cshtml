@model SmartExpenseTracker.Models.UserModel

<style>
    :root {
        --primary: #4f8eff;
        --secondary: #b06cff;
        --bg: rgba(13,18,36,.9);
        --text: #eef1fb;
        --muted: #94a3b8;
        --border: rgba(255,255,255,.12);
    }

    .register-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .rc {
        width: 100%;
        max-width: 450px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px;
        backdrop-filter: blur(12px);
    }

    .rc-badge {
        width: 50px;
        height: 50px;
        margin: 0 auto 16px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: linear-gradient(135deg,var(--primary),var(--secondary));
    }

    .rc-title {
        text-align: center;
        color: var(--text);
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .rc-sub {
        text-align: center;
        color: var(--muted);
        font-size: .9rem;
        margin-bottom: 24px;
    }

    .rc-grid {
        display: grid;
        gap: 16px;
    }

    .rc-field {
        display: flex;
        flex-direction: column;
    }

    .rc-label {
        color: var(--muted);
        font-size: .8rem;
        margin-bottom: 6px;
    }

    .rc-wrap {
        position: relative;
    }

    .rc-ico {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
    }

    .rc-input {
        width: 100%;
        padding: 12px 14px 12px 42px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.05);
        color: var(--text);
        outline: none;
        box-sizing: border-box;
    }

        .rc-input:focus {
            border-color: var(--primary);
        }

    .field-validation-error {
        color: #f87171;
        font-size: .75rem;
        margin-top: 4px;
    }

    .pwd-eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
    }

    .rc-btn {
        width: 100%;
        margin-top: 20px;
        padding: 13px;
        border: none;
        border-radius: 12px;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
        background: linear-gradient(135deg,var(--primary),var(--secondary));
    }

    .rc-foot {
        text-align: center;
        margin-top: 16px;
        color: var(--muted);
        font-size: .85rem;
    }

        .rc-foot a {
            color: var(--primary);
            text-decoration: none;
        }

    .validation-summary-errors {
        color: #f87171;
        margin-bottom: 15px;
    }

    @@media(max - width:480px) {
        .rc {
            padding: 24px;
        }

        .rc-title {
            font-size: 1.4rem;
        }
    }
</style>

<div class="register-page">
    <div class="rc">

        <div class="rc-badge" aria-hidden="true">🚀</div>
        <h1 class="rc-title">Create account</h1>
        <p class="rc-sub">Join SmartExpenseTracker and take control of your finances</p>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-action="ReceiveRegister" method="post">
            @Html.AntiForgeryToken()

            <div class="rc-grid">

                <div class="rc-field">
                    <label class="rc-label" asp-for="FullName">Full name</label>
                    <div class="rc-wrap">
                        <span class="rc-ico" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                            </svg>
                        </span>
                        <input asp-for="FullName" class="rc-input" placeholder="Enter FullName" autocomplete="name"/>
                    </div>
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>

                <div class="rc-field">
                    <label class="rc-label" asp-for="UserName">Username</label>
                    <div class="rc-wrap">
                        <span class="rc-ico" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                            </svg>
                        </span>
                        <input asp-for="UserName" class="rc-input" placeholder="Enter UserName" autocomplete="username"/>
                    </div>
                    <span asp-validation-for="UserName" class="field-validation-error"></span>
                </div>

                <div class="rc-field full">
                    <label class="rc-label" asp-for="Email">Email address</label>
                    <div class="rc-wrap">
                        <span class="rc-ico" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/>
                            </svg>
                        </span>
                        <input asp-for="Email" class="rc-input" placeholder="Enter Gmail" autocomplete="email"/>
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

              <div class="rc-field full">

    <label class="rc-label" asp-for="Password">Password</label>

    <div class="rc-wrap">

        <span class="rc-ico" aria-hidden="true">
            🔒
        </span>

        <input asp-for="Password"
               id="passwordInput"
               class="rc-input"
               type="password"
               placeholder="Enter Password" autocomplete="new-password"/>

        <button type="button"
                class="pwd-eye-btn"
                onclick="togglePwd()">
            👁
        </button>

    </div>

    <span asp-validation-for="Password" class="field-validation-error"></span>

</div>

            </div>

            <button type="submit" class="rc-btn">Create Account</button>

        </form>
        <br />
        <p class="rc-foot">
            Already have an account?
            <a asp-controller="User" asp-action="Login">Sign in</a>
        </p>

    </div>
</div>

@section Scripts {
<script>
function togglePwd() {
    const input = document.getElementById("passwordInput");

    if (input.type === "password") {
        input.type = "text";
    } else {
        input.type = "password";
    }
}
</script>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
