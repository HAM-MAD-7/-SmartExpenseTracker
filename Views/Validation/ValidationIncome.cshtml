<style>
    .validation-page {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 16px;
    }

    .validation-card {
        width: 100%;
        max-width: 600px;
        padding: 40px;
        text-align: center;
        border-radius: 24px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(245,158,11,.25);
        backdrop-filter: blur(12px);
        box-shadow: 0 12px 35px rgba(0,0,0,.25);
    }

    .validation-icon {
        font-size: 3.5rem;
        margin-bottom: 14px;
    }

    .validation-title {
        color: var(--text-primary);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .validation-text {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .validation-buttons {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .validation-btn {
        padding: 14px 24px;
        border: none;
        border-radius: 14px;
        text-decoration: none;
        color: #fff;
        font-weight: 700;
        transition: .25s;
    }

    .add-btn {
        background: linear-gradient(135deg,#10b981,#059669);
    }

    .dashboard-btn {
        background: linear-gradient(135deg,#4f8eff,#b06cff);
    }

    .validation-btn:hover {
        transform: translateY(-2px);
    }

    @@media(max-width:768px) {

        .validation-card {
            padding: 28px 22px;
        }

        .validation-title {
            font-size: 1.6rem;
        }

        .validation-buttons {
            flex-direction: column;
        }

        .validation-btn {
            width: 100%;
        }
    }
</style>

<div class="validation-page">

    <div class="validation-card">

        <div class="validation-icon">
            ⚠️
        </div>

        <h1 class="validation-title">
            Income Must Be Greater Than Zero!
        </h1>

        <p class="validation-text">
            Please add a valid income amount or go back to dashboard.
        </p>

        <div class="validation-buttons">

            <a asp-controller="Income"
                   asp-action="AddIncome"
                   class="validation-btn add-btn">
                💰 Add Income
            </a>

            <a asp-controller="Dashboard"
                   asp-action="Dash"
                   class="validation-btn dashboard-btn">
                🏠 Dashboard
            </a>

        </div>

    </div>

</div>
