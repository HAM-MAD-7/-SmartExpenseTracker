<style>

.validation-page {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 16px;
}

.validation-card {
    width: 100%;
    max-width: 650px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(245,158,11,.35);
    border-radius: 28px;
    padding: 45px;
    text-align: center;
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    box-shadow:
        0 24px 60px rgba(0,0,0,.45),
        0 0 80px rgba(245,158,11,.18);
    position: relative;
    overflow: hidden;
    transition: .35s ease;
}

.validation-card::before {
    content: '';
    position: absolute;
    width: 260px;
    height: 260px;
    top: -120px;
    right: -100px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,158,11,.45), transparent 70%);
    filter: blur(55px);
}

.validation-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    bottom: -100px;
    left: -80px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251,191,36,.35), transparent 70%);
    filter: blur(55px);
}

.validation-card:hover {
    transform: translateY(-8px);
    box-shadow:
        0 32px 75px rgba(0,0,0,.55),
        0 0 90px rgba(245,158,11,.35);
}

.validation-icon {
    font-size: 4rem;
    margin-bottom: 15px;
    position: relative;
    z-index: 1;
}

.validation-title {
    color: #F8FAFC;
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
}

.validation-text {
    color: #CBD5E1;
    font-size: 1rem;
    margin-bottom: 35px;
    position: relative;
    z-index: 1;
}

.validation-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
}

.validation-btn {
    padding: 14px 26px;
    border-radius: 16px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    color: white;
    font-weight: 700;
    transition: .3s;
}

/* Add Income Button */
.add-btn {
    background: linear-gradient(135deg,#10b981,#059669);
    box-shadow: 0 10px 30px rgba(16,185,129,.35);
}

.add-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(16,185,129,.5);
}

    /* Dashboard Button */
    .dashboard-btn {
        background: linear-gradient(135deg, #4f8eff, #b06cff);
        box-shadow: 0 10px 30px rgba(79,142,255,.35);
    }

        .dashboard-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 45px rgba(79,142,255,.5);
        }

@@media(max-width:768px) {
    .validation-card {
        padding: 30px 22px;
    }

    .validation-title {
        font-size: 1.6rem;
    }

    .validation-buttons {
        flex-direction: column;
    }
}
</style>

<div class="validation-page">

    <div class="validation-card">

        <div class="validation-icon">
            ⚠️
        </div>

        <h1 class="validation-title">
            Income Must Be Greater Than Zero!
        </h1>

        <p class="validation-text">
            Please add a valid income amount or go back to dashboard.
        </p>

        <div class="validation-buttons">

            <a asp-controller="Income"
                   asp-action="AddIncome"
                   class="validation-btn add-btn">
                💰 Add Income
            </a>

            <a asp-controller="Dashboard"
                   asp-action="Dash"
                   class="validation-btn dashboard-btn">
                🏠 Dashboard
            </a>

        </div>

    </div>

</div>
